{
  "name": "grasi-zumba-website",
  "version": "0.1.0",
  "private": true,
  "description": "Customer-facing website for Grasi's Zumba — energetic Brazilian-flavored Vue 3 + serverless AWS stack.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "api",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace shared && npm run build --workspace api && npm run build --workspace frontend",
    "build:shared": "npm run build --workspace shared",
    "build:api": "npm run build --workspace api",
    "build:frontend": "npm run build --workspace frontend",
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:frontend\"",
    "dev:api": "npm run dev --workspace api",
    "dev:frontend": "npm run dev --workspace frontend",
    "up": "docker compose up -d --wait",
    "up:all": "docker compose --profile apps up -d --wait",
    "down": "docker compose down",
    "reset": "docker compose down -v",
    "logs": "docker compose logs -f",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,vue,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,json,md,css}\"",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.31.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
