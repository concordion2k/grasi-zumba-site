# Copy to .env for local development (`cp api/.env.example api/.env`). Never commit real values.
# Defaults below target the LocalStack stack from docker-compose.yml — they work out of the box.

# DynamoDB table name (created by docker/localstack-init.sh)
TABLE_NAME=grasi-zumba-local

# S3 bucket for profile-picture uploads (created by docker/localstack-init.sh)
UPLOADS_BUCKET=grasi-zumba-uploads-local

AWS_REGION=us-east-1

# LocalStack accepts any credentials, but the SDK requires *some* to be set.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Point the SDK at LocalStack instead of real AWS. Leave BOTH unset in production.
DYNAMODB_ENDPOINT=http://localhost:4566
S3_ENDPOINT=http://localhost:4566
# Local S3 emulators need path-style URLs. Must be "false"/unset against real AWS.
S3_FORCE_PATH_STYLE=true

# HMAC pepper for hashing session tokens. Fine to use a throwaway value locally.
# Generate a real one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=local-dev-secret-change-me

# Comma-separated emails auto-promoted to admin on register/login (so you can test the admin UI).
ADMIN_BOOTSTRAP_EMAILS=admin@example.com

# Allowed browser origin (the Vite dev server).
FRONTEND_ORIGIN=http://localhost:5173

# Must be false on plain-http localhost (Secure cookies require HTTPS).
COOKIE_SECURE=false

PORT=8787

# --- Email (Phase 1) ---
# 'log' just prints emails to the console (local default); 'ses' actually sends via Amazon SES.
EMAIL_MODE=log
EMAIL_FROM=Zumba by Grasiele <grasi@zumbabygrasiele.com>
# Where contact-form inquiries are delivered.
CONTACT_TO=grasi@zumbabygrasiele.com
# IANA timezone used to render class dates/times in notification emails.
DISPLAY_TIMEZONE=America/New_York
# Leave EMAIL_QUEUE_URL unset locally → events run inline (no SQS needed for dev).
# EMAIL_QUEUE_URL=

# --- Stripe (sandbox) ---
# Test secret key from the Stripe dashboard (Developers → API keys).
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret. Locally: `stripe listen --forward-to localhost:8787/api/stripe/webhook`
# prints a whsec_... — paste it here. In prod it comes from the dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs for your catalog (Stripe dashboard → Products → each price).
STRIPE_PRICE_PACK_5=price_...
STRIPE_PRICE_PACK_10=price_...
STRIPE_PRICE_PACK_20=price_...
STRIPE_PRICE_DROPIN=price_...
STRIPE_PRICE_SUBSCRIPTION=price_...
